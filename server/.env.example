# 서버 포트 (기본 4000)
PORT=4000

# 바인드 주소 (기본 127.0.0.1 — 같은 호스트에서만 닿는다).
# 리버스 프록시가 컨테이너 등 다른 네임스페이스에 있으면 0.0.0.0 으로 열어야 한다.
# 0.0.0.0 으로 열면 포트가 외부에 직접 노출되므로 방화벽으로 막고 프록시만 통하게 할 것.
HOST=127.0.0.1

# --- Google OAuth (데스크탑 loopback + PKCE) ---
# 데스크탑 앱을 지원하는 동안 유지한다.
# Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID > "데스크톱 앱" 으로 만든 값.
# 비워두면 앱 로그인 화면에서 구글 버튼이 숨고 개발용 로그인만 보인다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 웹 앱(PWA) ---
# PWA 가 떠 있는 출처. 쿠키로 인증된 쓰기 요청은 Origin 이 이 목록에 있어야 한다(CSRF 방어). 쉼표로 여러 개.
# 비워 두면 요청의 Host 와 같은 출처만 받는다 (로컬 개발용 Vite 프록시는 이걸로 충분하다).
# 구글 웹 로그인을 켜려면 반드시 채워야 한다. 첫 번째 값이 로그인 뒤 돌아갈 주소가 된다.
TODOBUDDY_WEB_ORIGIN=

# 세션 쿠키의 Secure 속성. http://localhost 는 브라우저가 Secure 쿠키를 받아 주므로 끌 일이 거의 없다.
# 휴대폰으로 LAN IP(http) 에 붙어 시험할 때만 false 로 둔다.
TODOBUDDY_COOKIE_SECURE=true

# --- Google OAuth (PWA, 서버 리다이렉트 + PKCE) ---
# Google Cloud Console 에서 "웹 애플리케이션" 유형으로 따로 만든 값.
# 승인된 리디렉션 URI 에 <TODOBUDDY_WEB_ORIGIN>/api/auth/google/callback 을 등록한다.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# 프록시 구성이 달라 콜백 주소가 위 규칙과 다를 때만 채운다.
GOOGLE_WEB_REDIRECT_URI=

# 이름만 입력해 로그인하는 개발용 통로. 기본은 꺼져 있고, 'true' 일 때만 열린다.
# 구글 OAuth 를 아직 붙이지 않았다면 이걸 켜야 로그인할 수 있다.
TODOBUDDY_ALLOW_DEV_LOGIN=true

# 세션 토큰 서명 키. 배포 전 반드시 바꿀 것.
TODOBUDDY_JWT_SECRET=todobuddy-dev-secret-change-me

# 요청 로그 끄기: off
TODOBUDDY_LOG=on

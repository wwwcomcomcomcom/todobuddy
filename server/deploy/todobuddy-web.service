# /etc/systemd/system/todobuddy-web.service
# 소개 사이트(web/). nginx 가 3000 을 맡고 / 를 여기(127.0.0.1:3001)로 넘긴다 (server/deploy/nginx-todobuddy-pwa.conf).
# 빌드(web/.next)는 todobuddy-deploy 가 web/ 이 바뀐 태그에서만 다시 만들어 바꿔 끼우고 이 서비스를 재시작한다.
# node 경로는 nvm 이 깐 위치다. Node 를 올리면 todobuddy-server.service·todobuddy-deploy 와 같이 바꿀 것.
[Unit]
Description=TodoBuddy landing site (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/todobuddy/web
Environment=PATH=/home/ubuntu/.nvm/versions/node/v24.21.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.nvm/versions/node/v24.21.0/bin/node /home/ubuntu/todobuddy/node_modules/next/dist/bin/next start --port 3001 --hostname 127.0.0.1
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

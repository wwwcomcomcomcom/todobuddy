{
  "name": "todobuddy-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TodoBuddy API server (Node.js + SQLite)",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",

{
  "name": "todobuddy",
  "version": "0.1.0",
  "private": true,
  "description": "친구·크루와 하루치 TODO 를 나누는 앱 (Flutter 데스크탑 + React PWA 클라이언트 + Node.js/SQLite 서버)",
  "workspaces": [
    "server",
    "web",
    "pwa"
  ],
  "scripts": {
    "server": "npm --workspace server run start",
    "server:dev": "npm --workspace server run dev",
    "seed": "npm --workspace server run seed",
    "test:server": "npm --workspace server run test",
    "test:pwa": "npm --workspace pwa run test",
    "e2e:pwa": "npm --workspace pwa run e2e",
    "test:app": "cd app && flutter test --exclude-tags golden",
    "test": "npm run test:server && npm run test:pwa && npm run test:app",
    "app": "cd app && flutter run -d macos",
    "test:golden": "cd app && flutter test --tags golden",
    "dist:macos": "app/scripts/build_macos.sh",
    "web": "npm --workspace web run dev",
    "web:build": "npm --workspace web run build",
    "web:start": "npm --workspace web run start",
    "pwa": "npm --workspace pwa run dev",
    "pwa:build": "npm --workspace pwa run build",
    "pwa:preview": "npm --workspace pwa run preview"
  }
}
